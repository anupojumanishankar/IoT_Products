      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "PF Level Analysis",
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "JS",
          "jsScript": "function getPercentage(value) {\r\n  // Define the ranges and percentages as an array of objects\r\n  const ranges = [\r\n    { min: 0.951, max: 0.954, percentage: 0 },\r\n    { min: 0.955, max: 0.964, percentage: 0.5 },\r\n    { min: 0.965, max: 0.974, percentage: 1 },\r\n    { min: 0.975, max: 0.984, percentage: 1.5 },\r\n    { min: 0.985, max: 0.994, percentage: 2.5 },\r\n    { min: 0.995, max: 1.0, percentage: 3.5 },\r\n    { min: 0.895, max: 0.9, percentage: 0 },\r\n    { min: 0.885, max: 0.894, percentage: -1 },\r\n    { min: 0.875, max: 0.884, percentage: -1.5 },\r\n    { min: 0.865, max: 0.874, percentage: -2 },\r\n    { min: 0.855, max: 0.864, percentage: -2.5 },\r\n    { min: 0.845, max: 0.854, percentage: -3 },\r\n    { min: 0.835, max: 0.844, percentage: -3.5 },\r\n    { min: 0.825, max: 0.834, percentage: -4 },\r\n    { min: 0.815, max: 0.824, percentage: -4.5 },\r\n    { min: 0.001, max: 0.814, percentage: -5 }\r\n  ];\r\n\r\n  // Iterate through the ranges to find the corresponding percentage\r\n  for (let range of ranges) {\r\n    if (value >= range.min && value <= range.max) {\r\n      return range.percentage;\r\n    }\r\n  }\r\n\r\n  return null; \r\n}\r\n\r\nif (typeof msg.Avg_PF !== 'undefined') {\r\n    msg.PF_Level = getPercentage(msg.Avg_PF);\r\n\r\n    // Determine PF_Charges based on PF_Level\r\n    if (msg.PF_Level !== null) {\r\n        msg.PF_Charges = msg.PF_Level > 0 ? \"Incentive\" : msg.PF_Level < 0 ? \"Penalty\" : \"Neutral\";\r\n    }\r\n}\r\n\r\nreturn {msg: msg, metadata: metadata, msgType: msgType};\r\n",
          "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "additionalInfo": {
